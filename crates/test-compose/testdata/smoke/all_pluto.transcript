sudo chmod -R a+wrX .	<dir>
docker compose build --parallel	<dir>
docker compose up --remove-orphans --abort-on-container-exit --quiet-pull	<dir>
sudo chown -R <uid>:<gid> .	<dir>
sudo chmod -R a+wrX .	<dir>
sudo chown -R <uid>:<gid> .	<dir>
sudo chmod -R a+wrX .	<dir>
docker compose down --remove-orphans --timeout=2	<dir>
docker compose up --no-start --build	<dir>
docker compose build --parallel	<dir>
docker compose up --remove-orphans --abort-on-container-exit --quiet-pull	<dir>
sudo chown -R <uid>:<gid> .	<dir>
sudo chmod -R a+wrX .	<dir>
