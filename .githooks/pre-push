#!/usr/bin/env bash

set -e

# Dependency audit
if ! cargo deny check --hide-inclusion-graph; then
    echo "❌ Critical: Vulnerable dependencies detected (run 'cargo deny check --hide-inclusion-graph')"
    exit 1
fi

# Unused dependency check
if ! cargo machete; then
    echo "❌ Unused dependencies detected (run 'cargo machete')"
    exit 1
fi

# Formatting check (pinned nightly — see rustfmt-toolchain)
FMT_TOOLCHAIN="$(tr -d '[:space:]' < rustfmt-toolchain 2>/dev/null || echo nightly)"
if command -v cargo-+nightly >/dev/null 2>&1; then
    # Nix dev shell wraps `cargo +nightly fmt` to the pinned nightly.
    FMT_TOOLCHAIN="nightly"
fi
if ! cargo "+$FMT_TOOLCHAIN" fmt --all -- --check; then
    echo "❌ Formatting issues (run 'cargo +$FMT_TOOLCHAIN fmt --all')"
    exit 1
fi

# Linting
if ! cargo clippy --locked --all-targets --all-features -- -D warnings; then
    echo "❌ Clippy violations (check warnings above)"
    exit 1
fi

# Tests
if ! cargo test --locked --workspace --all-features; then
    echo "❌ Test failures detected"
    exit 1
fi

echo "✅ All checks passed!"
